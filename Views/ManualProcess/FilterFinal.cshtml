@model IEnumerable<JobAppHR.Models.ManualFilter>

@{
    ViewData["Title"] = "Select in to the final list from - " + ViewBag.CurrentStageName;
    Layout = "~/Views/Shared/_Layout.cshtml";
    int i = 0;
}

<style>
    .smallfont
    {
        font-size:smaller;
    }

    .table-shell {
        overflow-x: auto;
        padding-bottom: 0.5rem;
    }

    .table-shell .dataTables_wrapper {
        width: 100%;
    }

    .table-shell table.dataTable tbody td {
        vertical-align: top;
    }

    tfoot input {
        /*width: 100%;*/
        padding: 3px;
        box-sizing: border-box;
    }

    thead input {
        /*width: 100%;*/
        padding: 3px;
        box-sizing: border-box;
    }
</style>

<h4>@ViewData["Title"]</h4>

<form id="form" asp-action="UpdateFinal" method="post">
    @Html.Label("Intake Code")
    <input type="hidden" value="@ViewBag.CurrentStage" id="currentStage" name="currentStage" />
    <input type="text" value="@ViewBag.IntakeCode" id="intakeCode" name="intakeCode" style="border:none; font-weight: bold" readonly />
    
    <div class="float-end">
        @Html.ActionLink("Export to Excel", "ExportToExcel", "IntakeApplicant", new { intakeCode = @ViewBag.IntakeCode, currentStage = @ViewBag.CurrentStage, currentStatus = @ViewBag.CurrentStatus, freezeNo = @ViewBag.FreezeNo }, new { @class = "btn btn-outline-primary btn-sm" })
    </div>

    <br />
    <p>Make columns show/hide by clicking on below links</p>
    <div>
        <a class="toggle-vis" data-column="0">Application Code</a> - <a class="toggle-vis" data-column="1">Name</a> - <a class="toggle-vis" data-column="2">DOB</a> - <a class="toggle-vis" data-column="3">Age</a> - <a class="toggle-vis" data-column="4">Overage</a> - <a class="toggle-vis" data-column="5">A/L</a> - <a class="toggle-vis" data-column="6">Mandatory O/L Subject Results</a> - <a class="toggle-vis" data-column="7">O/L</a>
    </div>

    <div class="table-shell">
    <table class="table table-striped table-bordered dt-responsive compact nowrap" id="datagrid" style="width:100%">
        <thead>
            <tr>           
            <th>
                App.Code
            </th>
            <th>
                Name
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DOB)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Age)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Overage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ALGrades)
            </th>
            <th>
                M-Grades
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OLGrades)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HEQual)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProfQual)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WorkExp)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CurrentStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Remarks)
            </th>
            <th></th>
        </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) 
            {
                <tr>            
                    <td>
                        @Html.ActionLink(item.ApplicationCode,"ViewApplicantData","IntakeApplicant",new {applicationCode = item.ApplicationCode}, new { target = "_blank" })
                        <input type="hidden" asp-for="@item.ApplicationCode" />
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NameWithInitials)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DOB)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Age)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Overage)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ALGrades)
                    </td>
                    <td>
                        @{
                            if (item.OLMandatoryGrades != null)
                            {
                                string[] olgrades = item.OLMandatoryGrades.Split("|");
                                foreach (string y in olgrades)
                                {
                                    <text>&bull; @y</text>
                                    <br />
                                }
                            }
                        }
                    </td>
                    <td>
                        @{
                            if (item.OLGrades != null)
                            {
                                string[] olgrades = item.OLGrades.Split("|");
                                foreach (string y in olgrades)
                                {
                                    <text>&bull; @y</text>
                                    <br />
                                }
                            }
                        }
                    </td>
                    <td>
                        @{
                            if (item.HEQual != null)
                            {
                                string[] hequal = item.HEQual.Split("|");
                                foreach (string y in hequal)
                                {
                                    <text>&bull; @y</text>
                                    <br />
                                }
                            }
                        }
                    </td>
                    <td>
                        @{
                            if (item.ProfQual != null)
                            {
                                string[] profqual = item.ProfQual.Split("|");
                                foreach (string y in profqual)
                                {
                                    <text>&bull; @y</text>
                                    <br />
                                }
                            }
                        }
                    </td>
                    <td>
                        @{
                            if (item.WorkExp != null)
                            {
                                string[] hequal = item.WorkExp.Split("|");
                                foreach (string y in hequal)
                                {
                                    <text>&bull; @y</text>
                                    <br />
                                }
                            }
                        }
                    </td>
                    <td>
                        @* <input type="checkbox" name="CurrentStatus" id="status_@i" /> OK *@
                        <select name="CurrentStatus" id="status_@i">
                            @{
                                if (item.CurrentStatus == "PASS")
                                {
                                    <option value="PASS" selected>PASS</option>
                                }
                                else
                                {
                                    <option value="PASS">PASS</option>
                                }

                                if (item.CurrentStatus == "FAIL")
                                {
                                    <option value="FAIL" selected>FAIL</option>
                                }
                                else
                                {
                                    <option value="FAIL">FAIL</option>
                                }

                                if (item.CurrentStatus == "TO-CHECK")
                                {
                                    <option value="TO-CHECK" selected>TO-CHECK</option>
                                }
                                else
                                {
                                    <option value="TO-CHECK">TO-CHECK</option>
                                }
                            }
                        </select>
                        <input type="hidden" value="@item.CurrentStatus" name="oldstatus_@i" />
                        <input type="hidden" asp-for="@item.CurrentStatus" id="currentstatus_@i" />
                    </td>
@*                     <td>
                        @{
                            if (item.CurrentStatus == "PASS")
                            {
                                <input type="checkbox" name="CurrentStatus" id="status_@i" checked/>
                            }
                            else
                            {
                                <input type="checkbox" name="CurrentStatus" id="status_@i" />
                            }
                        }
                        <input type="hidden" value="@item.CurrentStatus" name="oldstatus_@i" />
                        <input type="hidden" asp-for="@item.CurrentStatus" id="currentstatus_@i"/>
                    </td> *@
                    <td>
                        @Html.DisplayFor(modelItem => item.Remarks)
                        <input type="hidden" asp-for="@item.Remarks" />
                        @*<input asp-for="@item.Remarks" id="remarks_@i"/>*@
                        <input type="text" id="newremarks_@i" name="newremarks_@i" />
                    </td>
                    <td>
                        @Html.ActionLink(" ","ViewProgress",new {applicationCode = item.ApplicationCode}, new { @class="fa fa-line-chart", @style="text-decoration:none;", title = "View Progress", target = "_blank"})
                    </td>
                </tr>
                i++;
            }
        </tbody>
        <tfoot>
            <tr>
                <th>App.Code</th>
                <th>Name</th>
                <th>DOB</th>
                <th>Age</th>
                <th>Overage</th>
                <th>A/L</th>
                <th>M-O/L</th>
                <th>O/L</th>
                <th>Higher Edu.</th>
                <th>Prof. Qual.</th>
                <th>Work Exp.</th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
        </tfoot>
    </table>
    </div>

    <br />
    <div><h5>If you have made any changes, first click on Save before confirming the list</h5></div>
    <div class="float-end">
        @{
            if (ViewBag.CurrentStage != "FAIL")
            {
                <button id="btnConfirm" type="button" class="btn btn-danger">Confirm & Freeze</button>
            }
        }
        <button id="btnProceed" type="submit" class="btn btn-success">Save</button>
    </div>
</form>

@section Scripts {
    <script src="~/lib/sweetalert/sweetalert.min.js"></script>
    <script>
        $(document).ready(function() 
        {
            //$('#datagrid').DataTable({
            //    "paging": false,
            //    columnDefs: [
            //        { targets: [$('thead tr th').length - 1],"orderable": false,}
            //    ],
            //    scrollX: true,
            //});

            $('input[type="checkbox"]').change(function (event) {
                var ctrlId = $(this).attr('id');
                var statusId = "#currentstatus_" + ctrlId.substring(7);
                var remarksId = "#remarks_" + ctrlId.substring(7);

                if (this.checked) {
                    $(statusId).val("PASS");
                    //alert($(statusId).val());
                }
                else {
                    $(statusId).val("FAIL");
                }
            });

            $("select").on('change', function (e) {
                var optionSelected = $("option:selected", this);
                var valueSelected = $(this).val();

                //alert(valueSelected);

                var ctrlId = $(this).attr('id');
                var statusId = "#currentstatus_" + ctrlId.substring(7); //7 is starting index of id of the element status_
                var remarksId = "#remarks_" + ctrlId.substring(7);

                $(statusId).val(valueSelected);
            });

            $('#btnConfirm').click(function () {
                var intakeCode = $("#intakeCode").val();
                swal({
                    title: "Are you sure to confirm & freeze?",
                    text: "Once freezed, you will not be able to revise the list!",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                })
                    .then((willConfirm) => {
                        if (willConfirm) {
                            if (intakeCode.indexOf('/TP') != -1) //found
                            {
                                //alert("tp");
                                var url = '@Url.Action("ConfirmFinal", "ManualProcess", new { intakeCode = ViewBag.IntakeCode })';
                            }
                            else
                            {
                                //alert("pp");
                                var url = '@Url.Action("ConfirmFinal", "FilterProcess", new { intakeCode = ViewBag.IntakeCode })';
                            }
                            window.location.href = url;
                            //window.location.href = "/ManualProcess/ManualProcess?intakeCode=" + intakeCode;
                        }
                    });
            });

            const table = new DataTable('#datagrid', {
                columnDefs: [{
                    targets: [11, 12, 13],
                    "orderable": false,
                }],
                "paging": false,
                initComplete: function () {

                    var r = $('#datagrid tfoot tr');
                    r.find('th').each(function () {
                        $(this).css('padding', 5);
                    });
                    $('#datagrid thead').append(r);
                    //$('#search_0').css('text-align', 'center');

                    this.api()
                        .columns()
                        .every(function (colIdx) {
                            let column = this;
                            let title = column.footer().textContent;

                            if (colIdx == 11 || colIdx == 12 || colIdx == 13) return;

                            // Create input element
                            let input = document.createElement('input');
                            input.style.width = '80px';
                            input.placeholder = title;
                            column.footer().replaceChildren(input);

                            // Event listener for user input
                            input.addEventListener('keyup', () => {
                                if (column.search() !== this.value) {
                                    column.search(input.value).draw();
                                }

                                if (input.value != "") {
                                    $("#btnProceed").prop("disabled", true);
                                    $("#btnConfirm").prop("disabled", true);
                                } else {
                                    $("#btnProceed").prop("disabled", false);
                                    $("#btnConfirm").prop("disabled", false);
                                }
                            });

                            input.addEventListener('click', function (e) {
                                e.stopPropagation();
                            });
                        });


                }
            });

            document.querySelectorAll('a.toggle-vis').forEach((el) => {
                el.addEventListener('click', function (e) {
                    e.preventDefault();

                    let columnIdx = e.target.getAttribute('data-column');
                    let column = table.column(columnIdx);

                    // Toggle the visibility
                    column.visible(!column.visible());
                });
            });

            $('#dt-search-0 input').on('input', function () {
                if ($(this).val() != "") {
                    $("#btnProceed").prop("disabled", true);
                }
                else {
                    $("#btnProceed").prop("disabled", false);
                }
            });

            $('input[type="search"]').on('input', function () {
                if ($(this).val() != "") {
                    $("#btnProceed").prop("disabled", true);
                }
                else {
                    $("#btnProceed").prop("disabled", false);
                }
            });
        });
    </script>
}
