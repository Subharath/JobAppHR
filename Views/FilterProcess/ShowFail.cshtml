@model IEnumerable<JobAppHR.Models.FailedApplicants>

@{
    ViewData["Title"] = "Non-Eligible Applicants";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int i = 0;
}

<h4>@ViewData["Title"]</h4>

<form id="form" asp-action="UpdateFail" method="post">
    @Html.Label("Intake Code")
    <input type="text" value="@ViewBag.IntakeCode" id="intakeCode" name="intakeCode" style="border:none; font-weight: bold" readonly />
    
    <div class="float-end">
        @Html.ActionLink("Export to Excel", "ExportToExcel", "IntakeApplicant", new { intakeCode = @ViewBag.IntakeCode, currentStage = "FAIL", freezeNo = @ViewBag.FreezeNo }, new { @class = "btn btn-outline-primary btn-sm" })
    </div>
    <br />
    <table class="table table-striped table-bordered dt-responsive compact" id="datagrid" style="width:100%">
    <thead>
        <tr>           
            <th>
                @Html.DisplayNameFor(model => model.ApplicationCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NameWithInitials)
            </th>
            <th>
                Stage
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FailedRemarks)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CurrentStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Remarks)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) 
        {
            <tr>            
                <td>
                    @Html.ActionLink(item.ApplicationCode,"ViewApplicantData","IntakeApplicant",new {applicationCode = item.ApplicationCode}, new { target = "_blank" })
                    <input type="hidden" asp-for="@item.ApplicationCode" />
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NameWithInitials)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FailedStatus)
                    <text> @@ Stage </text>
                    @Html.DisplayFor(modelItem => item.FailedStage)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FailedRemarks)
                    <input type="hidden" asp-for="@item.FailedRemarks" />
                </td>
                <td>
                    <input type="checkbox" name="CurrentStatus" id="status_@i" /> OK
                    <input type="hidden" asp-for="@item.CurrentStatus" id="currentstatus_@i" />
                </td>
                <td>
                    @*<input type="text" name="Remarks" value="@item.Remarks" />*@
                    <input asp-for="@item.Remarks" id="remarks_@i" class="form-control form-control-sm" maxlength="150"/>
                </td>
                <td>
                    @Html.ActionLink(" ","ViewProgress",new {applicationCode = item.ApplicationCode}, new { @class="fa fa-line-chart", @style="text-decoration:none;", title = "View Progress", target = "_blank"})
                </td>
            </tr>
            i++;
        }
    </tbody>
</table>

    <div><h5>When applicants in this list are made Eligible and Saved, they will be transferred to final eligible list</h5></div>

    <br />
    <div class="float-end">
        <button id="btnProceed" type="submit" class="btn btn-success">Save & Close</button>
    </div>
</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#datagrid').DataTable({
                "paging": false,
                columnDefs: [
                    { targets: [$('thead tr th').length - 1], "orderable": false, }
                ],
            });

            $('input[type="checkbox"]').change(function (event) {
                var ctrlId = $(this).attr('id');
                var statusId = "#currentstatus_" + ctrlId.substring(7);
                var remarksId = "#remarks_" + ctrlId.substring(7);

                if (this.checked)
                {
                    $(statusId).val("PASS");
                }
                else 
                {
                    $(statusId).val("FAIL");
                }
            });

            $('input[type="search"]').on('input', function () {

                if ($(this).val() != "") {
                    $("#btnProceed").prop("disabled", true);
                }
                else {
                    $("#btnProceed").prop("disabled", false);
                }
            });
        });
    </script>
}
