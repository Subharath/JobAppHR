<form asp-action="ViewApplicantList">
    <div class="form-group row">
        <div><h5>Freezed Talent Pool Intakes</h5></div>
        <br />
        <br />
        <div class="col-2">
            <label class="control-label">Select Intake Code</label>
        </div>
        <div class="col-2">
            <select name="IntakeCode" id="IntakeCode" class="form-select form-select-sm" asp-items="@ViewBag.IntakeCode">
            </select>
        </div>
        <div class="col-2">
            <label id="JobPositionName" class="label-display me-4"></label>
        </div>
        <div class="col-2">
            <input type="button" value="View" class="btn btn-primary btn-sm" id="btnView" />
        </div>
    </div>
</form>

<hr />

<div id="searchResults">
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            
            if ('@ViewBag.IsSelected' == "YES")
            {
                loadResult();
            }

            GetJobPositionName();

            $('#IntakeCode').on('change', function () {
                GetJobPositionName();
            });

            $('#btnView').click(function () {
                loadResult();
            });

            function loadResult()
            {
                var url = '@Url.Action("FreezeSummary", "EligibleApplicant")';
                var intakeCode = $('#IntakeCode').val();
                $('#searchResults').load(url, { intakeCode: intakeCode });
            }

            function GetJobPositionName()
            {
                var intakeCode = $('#IntakeCode').val();
                fetch('@Url.Action("GetJobPositionName", "EligibleApplicant")' + '?intakeCode=' + intakeCode)
                    .then(response => response.json())
                    .then(data =>
                    {
                        $('#JobPositionName').text(data.jobPositionName);
                    });
            }
        });
    </script>
}
